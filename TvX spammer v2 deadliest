-- Spammer Logic with Multi-Target Support
local spamming = false

StartBtn.MouseButton1Click:Connect(function()
    spamming = not spamming
    if spamming then
        StartBtn.Text = "STATUS: ON 🟢"
        StartBtn.TextColor3 = Color3.fromRGB(0, 255, 100)
        StartStroke.Color = Color3.fromRGB(0, 255, 100)
        
        task.spawn(function()
            local index = 1
            while spamming do
                local targets = {}
                if TargetBox1.Text ~= "" then table.insert(targets, TargetBox1.Text) end
                if TargetBox2.Text ~= "" then table.insert(targets, TargetBox2.Text) end
                if TargetBox3.Text ~= "" then table.insert(targets, TargetBox3.Text) end
                if TargetBox4.Text ~= "" then table.insert(targets, TargetBox4.Text) end
                
                if #targets == 0 then table.insert(targets, "Target") end
                
                for _, targetName in ipairs(targets) do
                    if not spamming then break end
                    
                    local rawPreset = presets[index]
                    local finalMsg = rawPreset:gsub("%[Target Name%]", targetName)
                    
                    sendChatMessage(finalMsg)
                    
                    index = index + 1
                    if index > #presets then
                        index = 1
                    end
                    
                    local delayTime = tonumber(DelayBox.Text) or 1.5
                    if delayTime < 0.1 then delayTime = 0.1 end
                    if delayTime > 10 then delayTime = 10 end
                    
                    task.wait(delayTime)
                end
            end
        end)
    else
        StartBtn.Text = "START TVX V3 ULTRA"
        StartBtn.TextColor3 = Color3.fromRGB(255, 0, 128)
        StartStroke.Color = Color3.fromRGB(255, 0, 128)
    end
end)

